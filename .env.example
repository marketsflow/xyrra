# Resend (https://resend.com) — used by the Vite dev server and by Vercel /api/contact
# Never commit a real .env file with secrets.

RESEND_API_KEY=re_your_resend_api_key
# Where you receive contact messages (your inbox)
RESEND_TO_EMAIL=tom@xyrra.ai
# Optional; defaults to Xyrra <onboarding@resend.dev> (Resend test sender)
# Use a verified domain sender in production, e.g. "Xyrra <hello@yourdomain.com>"
RESEND_FROM_EMAIL=Xyrra <onboarding@resend.dev>

# Resend webhook for outreach open/click/delivery tracking.
# In the Resend dashboard, add https://xyrra.ai/api/resend-webhook
# and subscribe to: email.delivered, email.opened, email.clicked, email.bounced, email.complained.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Service role is required for the webhook to write tracking events (bypasses RLS).
# Local: copy SERVICE_ROLE_KEY from `supabase status -o env`
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local Supabase Auth also uses RESEND_API_KEY (via supabase/.env).
# The CLI does not load .env.local automatically — symlink it:
#   ln -sfn ../.env.local supabase/.env

# Optional: if the contact API is hosted at a different origin
# VITE_CONTACT_API_URL=https://yourdomain.com/api/contact

# Optional: Xyrra Agent installer URLs (shown after the download lead form)
# VITE_XYRRA_AGENT_DOWNLOAD_MAC=https://yourdomain.com/downloads/Xyrra-Agent.dmg
# VITE_XYRRA_AGENT_DOWNLOAD_WIN=https://yourdomain.com/downloads/Xyrra-Agent.exe
# VITE_XYRRA_AGENT_DOWNLOAD_LINUX=https://yourdomain.com/downloads/Xyrra-Agent.AppImage

# Canonical site URL (documented for SEO: sitemap, robots, and static HTML use https://xyrra.ai)
# VITE_SITE_URL=https://xyrra.ai

# Supabase (local: run `supabase status -o env` and copy API_URL + ANON_KEY)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
