# Resend (https://resend.com) — used by the Vite dev server and by Vercel /api/contact
# Never commit a real .env file with secrets.

RESEND_API_KEY=re_your_resend_api_key
# Where you receive contact messages (your inbox)
RESEND_TO_EMAIL=tom@xyrra.ai
# Optional; defaults to Xyrra <onboarding@resend.dev> (Resend test sender)
# Use a verified domain sender in production, e.g. "Xyrra <hello@yourdomain.com>"
RESEND_FROM_EMAIL=Xyrra <onboarding@resend.dev>

# Resend webhook for outreach open/click/delivery tracking.
# In the Resend dashboard, add https://www.xyrra.ai/api/resend-webhook
# (Use www — bare xyrra.ai 307-redirects and Resend will not follow it.)
# and subscribe to: email.delivered, email.opened, email.clicked, email.bounced, email.complained.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# Service role is required for the webhook to write tracking events (bypasses RLS),
# and for /api/unsubscribe to record outreach opt-outs.
# Local: copy SERVICE_ROLE_KEY from `supabase status -o env`
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# EODHD (https://eodhd.com) — used by /api/stock-prices (admin "Stock Prices" page) to fetch EOD stock prices
EODHD_API_BASE_URI=https://eodhd.com/api/
EODHD_API_KEY=your_eodhd_api_key

# Polymarket ingest (/api/ingest-polymarket). Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Also allows admin/editor session tokens from the admin Polymarket page.
CRON_SECRET=your_long_random_cron_secret
# Optional overrides (defaults: btc / BTC)
# POLYMARKET_ASSET=btc
# POLYMARKET_SYMBOL=BTC

# Always-on live trading bot (/api/live-trading-account + future order bot).
# Private key stays on the server only — never commit a real key, never put it in VITE_*.
# Must be the MetaMask "Show private key" value: 64 hex chars, optional 0x prefix.
# Do NOT use the 12/24-word Secret Recovery Phrase. Do NOT wrap the value in quotes.
# POLYMARKET_PRIVATE_KEY=0xabc123...   # exactly 64 hex digits after 0x
# POLYMARKET_WALLET_ADDRESS=0x…        # optional: deposit / Safe / proxy funder address
#   (copy from polymarket.com profile if MetaMask EOA ≠ where USDC sits)
# Restart `npm run dev` after changing these.

# Crypto 1m ingest (/api/ingest-crypto). Same CRON_SECRET auth as Polymarket.
# Defaults: BTC + USDT → Binance BTCUSDT 1m klines into crypto_prices (timeframe=1).
# CRYPTO_INGEST_SYMBOL=BTC
# CRYPTO_INGEST_QUOTE=USDT

# Crypto SMA/EMA + bar characteristics + price action (/api/compute-crypto-ma).
# Same CRON_SECRET auth. Runs every minute: materializes latest 5m/15m/1h/4h/1D
# candles from 1m, then upserts crypto_moving_averages, crypto_bar_characteristics,
# and crypto_price_action in parallel (same cron tick → minimal lag).
# Full history backfill (from first stored candle):
#   node scripts/backfill-crypto-ma.mjs
#   node scripts/backfill-crypto-price-action.mjs
#   or GET/POST /api/compute-crypto-ma?backfill=1 with Bearer CRON_SECRET / admin token

# Local Supabase Auth also uses RESEND_API_KEY (via supabase/.env).
# The CLI does not load .env.local automatically — symlink it:
#   ln -sfn ../.env.local supabase/.env

# Optional: if the contact API is hosted at a different origin
# VITE_CONTACT_API_URL=https://yourdomain.com/api/contact

# Optional: Xyrra Agent installer URLs (shown after the download lead form)
# VITE_XYRRA_AGENT_DOWNLOAD_MAC=https://yourdomain.com/downloads/Xyrra-Agent.dmg
# VITE_XYRRA_AGENT_DOWNLOAD_WIN=https://yourdomain.com/downloads/Xyrra-Agent.exe
# VITE_XYRRA_AGENT_DOWNLOAD_LINUX=https://yourdomain.com/downloads/Xyrra-Agent.AppImage

# Canonical site URL (documented for SEO: sitemap, robots, and static HTML use https://xyrra.ai)
# VITE_SITE_URL=https://xyrra.ai

# Supabase (local: run `supabase status -o env` and copy API_URL + ANON_KEY)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google and Apple sign-in for Supabase Auth. The browser never sees these.
# Local Auth reads them from supabase/.env (symlink of .env.local).
# Google: OAuth client (Web) in Google Cloud, redirect https://<project-ref>.supabase.co/auth/v1/callback
# Apple: Services ID + signing key. Secret is the Apple client secret JWT.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
