{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/new", "destination": "/", "permanent": true },
    { "source": "/new/", "destination": "/", "permanent": true },
    { "source": "/new_home", "destination": "/", "permanent": true },
    { "source": "/new_home/", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/articles", "destination": "/api/articles-page?view=index" },
    { "source": "/articles/", "destination": "/api/articles-page?view=index" },
    { "source": "/articles/:slug", "destination": "/api/articles-page?slug=:slug" },
    { "source": "/articles/:slug/", "destination": "/api/articles-page?slug=:slug" },
    { "source": "/sitemap-articles.xml", "destination": "/api/articles-page?view=sitemap" },
    { "source": "/llms-articles.txt", "destination": "/api/articles-page?view=llms" },
    { "source": "/api/webhooks/resend", "destination": "/api/resend-webhook" },
    { "source": "/api/webhooks/resend/", "destination": "/api/resend-webhook" },
    { "source": "/api/website/ai-stocks/history", "destination": "https://app.xyrra.ai/api/website/ai-stocks/history" },
    { "source": "/api/website/ai-stocks/last-24-hours", "destination": "https://app.xyrra.ai/api/website/ai-stocks/last-24-hours" },
    { "source": "/api/website/ai-stocks/last-7-days", "destination": "https://app.xyrra.ai/api/website/ai-stocks/last-7-days" },
    { "source": "/api/website/ai-stocks/last-30-days", "destination": "https://app.xyrra.ai/api/website/ai-stocks/last-30-days" },
    { "source": "/api/website/ai-stocks", "destination": "https://app.xyrra.ai/api/website/ai-stocks" },
    { "source": "/api/website/ai-crypto/history", "destination": "https://app.xyrra.ai/api/website/ai-crypto/history" },
    { "source": "/api/website/ai-crypto/last-24-hours", "destination": "https://app.xyrra.ai/api/website/ai-crypto/last-24-hours" },
    { "source": "/api/website/ai-crypto/last-7-days", "destination": "https://app.xyrra.ai/api/website/ai-crypto/last-7-days" },
    { "source": "/api/website/ai-crypto/last-30-days", "destination": "https://app.xyrra.ai/api/website/ai-crypto/last-30-days" },
    { "source": "/api/website/ai-crypto", "destination": "https://app.xyrra.ai/api/website/ai-crypto" },
    { "source": "/api/website/ai-portfolios", "destination": "https://app.xyrra.ai/api/website/ai-portfolios" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/freecaps-community",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/freecaps-community/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "functions": {
    "api/contact.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/email-outreach.ts": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/resend-webhook.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/unsubscribe.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/freecaps-signup.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/stock-prices.ts": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/ingest-polymarket.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/ingest-crypto.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/compute-crypto-ma.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/articles-page.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/ingest-polymarket",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/ingest-crypto",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/compute-crypto-ma",
      "schedule": "* * * * *"
    }
  ]
}
